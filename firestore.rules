rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow users to read/write their own data in any collection
    match /{collection}/{document} {
      allow read: if request.auth != null && 
        (request.auth.uid == resource.data.userId || 
         request.auth.uid == resource.data.uid ||
         !("userId" in resource.data) && !("uid" in resource.data));
      allow write: if request.auth != null && 
        (request.auth.uid == request.resource.data.userId || 
         request.auth.uid == request.resource.data.uid ||
         (!("userId" in request.resource.data) && !("uid" in request.resource.data)));
      allow create: if request.auth != null;
    }
    
    // Specific rules for stockxPricingSettings collection
    match /stockxPricingSettings/{document} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow write: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }
    
    // Allow authenticated users to read and write their own purchases
    match /purchases/{purchase} {
      allow read: if request.auth != null && 
        (request.auth.uid == resource.data.userId || 
         request.auth.uid == resource.data.uid ||
         !("userId" in resource.data) && !("uid" in resource.data));
      allow write: if request.auth != null && 
        (request.auth.uid == request.resource.data.userId || 
         request.auth.uid == request.resource.data.uid ||
         (!("userId" in request.resource.data) && !("uid" in request.resource.data)));
      allow create: if request.auth != null && 
        (request.auth.uid == request.resource.data.userId || 
         request.auth.uid == request.resource.data.uid ||
         (!("userId" in request.resource.data) && !("uid" in request.resource.data)));
      allow delete: if request.auth != null && 
        (request.auth.uid == resource.data.userId || 
         request.auth.uid == resource.data.uid ||
         !("userId" in resource.data) && !("uid" in resource.data));
    }
    
    // Allow authenticated users to read and write their own sales
    match /sales/{sale} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }
    
    // Allow authenticated users to read and write their own profiles
    match /profiles/{profile} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == profile;
    }
    
    // Allow authenticated users to read themes
    match /themes/{theme} {
      allow read: if request.auth != null;
      allow write: if false; // Only admin can write themes
    }
    
    // Allow authenticated users to read and write their own email configs
    match /emailConfigs/{config} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }
    
    // Allow authenticated users to read and write their own dashboard settings
    match /dashboardSettings/{setting} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }
    
    // Allow authenticated users to read and write their own monitored products
    match /monitored_products/{product} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }
    
    // Allow authenticated users to read and write their own themes
    match /user_themes/{theme} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }
    
    // Allow authenticated users to read and write their own failed verifications
    match /user_failed_verifications/{verification} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }
    
    // Allow authenticated users to read and write their own user document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
    }
    
    // Allow authenticated users to read and write their nested user data
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
    }
    
    // Allow any user to read/write their own data in user_sales collection
    match /user_sales/{sale} {
      // Allow Firebase authenticated users
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      
      // Allow site password users (no auth but with userId in data)
      allow read, write: if request.auth == null && resource.data.userId != null;
      allow create: if request.auth == null && request.resource.data.userId != null;
      
      // Allow any user with valid userId in the data (for API endpoints)
      allow read, write: if resource.data.userId != null;
      allow create: if request.resource.data.userId != null;
    }
  }
}