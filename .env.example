# Example environment file (no secrets)
NEXT_PUBLIC_BASE_URL=https://www.solesmarket.com
# StockX (fill with your values in .env.local)
STOCKX_CLIENT_ID=your_client_id
STOCKX_CLIENT_SECRET=your_client_secret
STOCKX_API_KEY=your_api_key_or_same_as_client_id
# UPS/FedEx optional placeholders
UPS_CLIENT_ID=your_ups_client_id
UPS_CLIENT_SECRET=your_ups_client_secret
FEDEX_API_KEY=your_fedex_api_key
FEDEX_SECRET_KEY=your_fedex_secret
